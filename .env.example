REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=news.raw
GDELT_QUERY=(climate OR earthquake OR economy OR technology)
COLLECT_INTERVAL_SECONDS=900
RSS_URLS=
# JSON file with explicitly curated RSS feed location/thumbnail permissions.
RSS_POLICY_FILE=/app/collector/rss-policy.json
SPARK_MASTER=local[1]
SPARK_CHECKPOINT=/var/lib/terra/checkpoints/news
SPARK_MAX_OFFSETS=200
SPARK_TRIGGER_SECONDS=30
SPARK_DRIVER_MEMORY=768m
GEOGRAPHY_DIR=/app/geo/generated
WEB_PORT=8080
