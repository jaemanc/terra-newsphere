REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=news.raw
GDELT_QUERY=(climate OR earthquake OR economy OR technology)
COLLECT_INTERVAL_SECONDS=900
RSS_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/world/asia/rss.xml,https://feeds.bbci.co.uk/news/world/europe/rss.xml,https://feeds.bbci.co.uk/news/world/us_and_canada/rss.xml,https://feeds.bbci.co.uk/news/world/africa/rss.xml,https://feeds.bbci.co.uk/news/world/middle_east/rss.xml,https://feeds.bbci.co.uk/news/world/latin_america/rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml,https://feeds.bbci.co.uk/news/science_and_environment/rss.xml,https://feeds.bbci.co.uk/news/uk/rss.xml,https://feeds.bbci.co.uk/news/health/rss.xml,https://feeds.bbci.co.uk/news/politics/rss.xml,https://feeds.bbci.co.uk/news/education/rss.xml,https://feeds.bbci.co.uk/news/entertainment_and_arts/rss.xml,https://feeds.bbci.co.uk/news/england/rss.xml,https://feeds.bbci.co.uk/news/scotland/rss.xml,https://feeds.bbci.co.uk/news/wales/rss.xml,https://feeds.bbci.co.uk/news/northern_ireland/rss.xml,https://feeds.bbci.co.uk/news/bbcverify/rss.xml
# JSON file with explicitly curated RSS feed location/thumbnail permissions.
RSS_POLICY_FILE=/app/collector/rss-policy.json
SPARK_MASTER=local[1]
SPARK_CHECKPOINT=/var/lib/terra/checkpoints/news
SPARK_MAX_OFFSETS=200
SPARK_TRIGGER_SECONDS=30
SPARK_DRIVER_MEMORY=768m
GEOGRAPHY_DIR=/app/geo/generated
WEB_PORT=8080
# Optional public Cesium ion browser token (imagery-only scope and allowed origins).
# Empty uses OpenStreetMap for close views. Rebuild frontend when these values change.
VITE_CESIUM_ION_TOKEN=
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/
